
{
    "active_dataset": "retail",

    "universal_extraction": {
        "encoding": "auto",
        "delimiter": "auto",
        "header": true,
        "on_bad_lines": "error"
    },

    "universal_transformation": {
        "standardize_columns": true,
        "clean_text": true,
        "normalize_missing_values": true,
        "auto_convert_types": true,
        "detect_currency": true,
        "detect_percentage": true,
        "detect_dates": true,
        "detect_booleans": true,
        "track_conversion_failures": true
    },

    "universal_validation": {
        "missing_values": {
            "enabled": true
        },
        "duplicates": {
            "enabled": true
        },
        "identifiers": {
            "enabled": true
        },
        "conversion": {
            "enabled": true
        },
        "numeric": {
            "enabled": true
        },
        "dates": {
            "enabled": true
        },
        "contacts": {
            "enabled": true
        }
    },

    "universal_date_validation": {
        "date_ranges": {},
        "no_future_columns": [
            "transaction_date"
        ],
        "chronological_rules": [],
        "reference_time": null
    },

    "datasets": {
        "retail": {
            "input_file": "retail_sales.csv",
            "database": {
                "file": "data/retail_sales.db",
                "table": "retail_sales"
            },
            "validation_files": {
                "valid": "retail_valid_records.csv",
                "warnings": "retail_warning_records.csv",
                "rejected": "retail_rejected_records.csv"
            },
            "validation": {
                "required_columns": [
                    "order_id",
                    "order_date",
                    "quantity",
                    "price"
                ],
                "warning_columns": [
                    "customer_name",
                    "product",
                    "category",
                    "city"
                ],
                "positive_columns": [
                    "quantity",
                    "price"
                ],
                "date_columns": [
                    "order_date"
                ],
                "unique_columns": [
                    "order_id"
                ]
            },
            "transformation": {
                "date_columns": [
                    "order_date"
                ],
                "calculate_total": true,
                "quantity_column": "quantity",
                "price_column": "price",
                "total_column": "total_amount"
            }
        },

        "employee": {
            "input_file": "employees.csv",
            "database": {
                "file": "data/employee_data.db",
                "table": "employees"
            },
            "validation_files": {
                "valid": "employee_valid_records.csv",
                "warnings": "employee_warning_records.csv",
                "rejected": "employee_rejected_records.csv"
            },
            "validation": {
                "required_columns": [
                    "employee_id",
                    "employee_name",
                    "department",
                    "salary",
                    "joining_date"
                ],
                "warning_columns": [
                    "email",
                    "city"
                ],
                "positive_columns": [
                    "salary"
                ],
                "date_columns": [
                    "joining_date"
                ],
                "unique_columns": [
                    "employee_id"
                ]
            },
            "transformation": {
                "date_columns": [
                    "joining_date"
                ],
                "calculate_total": false
            }
        },

        "student": {
            "input_file": "students.csv",
            "database": {
                "file": "data/student_data.db",
                "table": "students"
            },
            "validation_files": {
                "valid": "student_valid_records.csv",
                "warnings": "student_warning_records.csv",
                "rejected": "student_rejected_records.csv"
            },
            "validation": {
                "required_columns": [
                    "student_id",
                    "student_name",
                    "course",
                    "marks",
                    "enrollment_date"
                ],
                "warning_columns": [
                    "email",
                    "city"
                ],
                "positive_columns": [
                    "marks"
                ],
                "date_columns": [
                    "enrollment_date"
                ],
                "unique_columns": [
                    "student_id"
                ]
            },
            "transformation": {
                "date_columns": [
                    "enrollment_date"
                ],
                "calculate_total": false
            }
        }
    },

    "quality_scoring": {
        "penalties": {
            "INVALID_EMAIL": 10,
            "INVALID_PHONE": 10,
            "MISSING_VALUE": 8,
            "CONVERSION_FAILURE": 12,
            "NUMERIC_OUTLIER": 8,
            "FUTURE_DATE": 8,
            "MISSING_REQUIRED_VALUE": 30,
            "DUPLICATE_RECORD": 40,
            "EXACT_DUPLICATE": 40,
            "DUPLICATE_KEY": 40,
            "EMPTY_RECORD": 50,
            "NUMERIC_RANGE_VIOLATION": 25,
            "DATE_RANGE_VIOLATION": 25,
            "INVALID_DATE": 12,
            "QUALITY_VALIDATION_FAILURE": 10
        },
        "severity_penalties": {
            "WARNING": 5,
            "REJECTED": 25
        }
    },

    "retry": {
        "enabled": true,
        "max_attempts": 3,
        "base_delay_seconds": 2,
        "max_delay_seconds": 30
    },

    "directories": {
        "raw": "data/raw",
        "processed": "data/processed",
        "rejected": "data/rejected"
    }
}
